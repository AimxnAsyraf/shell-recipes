---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Not found" description="This page doesn't exist.">
  <section class="hero">
    <p class="hero-kicker">$ cd this-page<br />bash: cd: this-page: No such file or directory</p>
    <h1>404: recipe not found.</h1>
    <p class="lead">That page doesn't exist (yet). <a href={url()}>Browse all recipes</a> or <a href={url('contribute/')}>add one</a>.</p>
  </section>
</Base>
